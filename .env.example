# Conexión pooled para la aplicación en Vercel.
DATABASE_URL=

# Conexión directa para migraciones de Drizzle Kit.
DATABASE_URL_UNPOOLED=

# URL pública de la aplicación, por ejemplo http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# URL del servicio administrado de Neon Auth.
NEON_AUTH_BASE_URL=

# Secreto de 32 caracteres o más para firmar cookies de sesión.
NEON_AUTH_COOKIE_SECRET=
